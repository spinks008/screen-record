{
  "name": "screen-record",
  "productName": "Screen Record",
  "version": "0.1.1",
  "description": "Screen recorder for Windows with automatic zoom, smooth cursor and a polished editor",
  "main": "out/main/index.js",
  "author": "SPINKS",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinks008/screen-record.git"
  },
  "homepage": "https://github.com/spinks008/screen-record#readme",
  "bugs": {
    "url": "https://github.com/spinks008/screen-record/issues"
  },
  "keywords": [
    "screen-recorder",
    "screen-recording",
    "auto-zoom",
    "video-editor",
    "electron",
    "windows"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@pixi/filter-drop-shadow": "^5.2.0",
    "@pixi/filter-motion-blur": "^5.1.1",
    "@pixi/filter-zoom-blur": "^5.1.1",
    "@pixi/unsafe-eval": "^7.4.3",
    "immer": "^11.1.21",
    "koffi": "^3.3.3",
    "mediabunny": "^1.61.4",
    "pixi.js": "^7.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uiohook-napi": "^1.5.5",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "koffi@3.3.3": true
  }
}
